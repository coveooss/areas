{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>coveo/renovate-presets"
  ],
  "postUpgradeTasks": {
    "commands": [
      "pnpm install --frozen-lockfile",
      "pnpm run build",
    ],
    "fileFilters": ["dist/index.js"],
    "executionMode": "branch"
  },
}
