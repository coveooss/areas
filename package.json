{
	"name": "areas",
	"version": "0.1.0",
	"description": "Manage and label areas in your repository based on the .areas configuration.",
	"main": "index.js",
	"scripts": {
		"build": "esbuild src/action.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"validate:renovate": "pnpm dlx --package renovate@43.89.1 -- renovate-config-validator",
		"format": "biome format --write .",
		"prepare": "husky",
		"changeset": "changeset",
		"version": "changeset version"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@11.2.2",
	"dependencies": {
		"@actions/core": "^3.0.0",
		"@actions/github": "^8.0.1",
		"fs-extra": "^11.3.3",
		"glob": "^13.0.0",
		"js-yaml": "^4.1.1",
		"minimatch": "^10.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.11",
		"@changesets/cli": "^2.29.8",
		"@types/fs-extra": "^11.0.4",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^25.9.1",
		"@vitest/coverage-v8": "^4.0.17",
		"esbuild": "0.28.0",
		"husky": "^9.1.7",
		"typescript": "^6.0.0",
		"vitest": "^4.0.17"
	}
}
